{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "mocha",
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "sdk/src/**/*.ts",
    "scripts/**/*.ts",
    "bots/**/*.ts",
    "app/src/actions.ts"
  ]
}